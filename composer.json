{
    "name": "fromholdio/phpstan-non-nullable-sink-rules",
    "type": "phpstan-extension",
    "description": "PHPStan rules for values that are not proven safe at non-nullable PHP-owned sinks.",
    "homepage": "https://github.com/fromholdio/phpstan-non-nullable-sink-rules",
    "license": "MIT",
    "keywords": [
        "phpstan",
        "phpstan-extension",
        "phpstan-rules",
        "static-analysis",
        "non-nullable"
    ],
    "require": {
        "php": "^8.1",
        "phpstan/phpstan": "^2.1.39"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "support": {
        "issues": "https://github.com/fromholdio/phpstan-non-nullable-sink-rules/issues",
        "source": "https://github.com/fromholdio/phpstan-non-nullable-sink-rules"
    },
    "autoload": {
        "psr-4": {
            "Fromholdio\\PHPStanNonNullableSinkRules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fromholdio\\PHPStanNonNullableSinkRules\\Tests\\": "tests/"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
